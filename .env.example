# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋하지 않습니다)
# Vercel에 배포할 때는 Project → Settings → Environment Variables 에 같은 이름으로 넣습니다.

# Supabase (v1과 같은 프로젝트) — 대시보드 → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 서버 전용 키: 대시보드 → Project Settings → API Keys 의 Secret key(sb_secret_…) 또는 service_role 키.
# (anon/publishable 키는 RLS가 켜진 새 표(app_status 등)에 쓰지 못합니다.) 서버에서만 쓰이고 브라우저로 나가지 않습니다.
SUPABASE_KEY=

# 로그인 쿠키 서명용 비밀값 (32자 이상 아무 문자열). 만드는 법: openssl rand -base64 32
SESSION_SECRET=

# /api/health 호출용 비밀값 (Vercel Cron이 자동으로 붙여 보냄). 만드는 법: openssl rand -hex 32
CRON_SECRET=

# Claude API (교사용 '학습지 업로드(AI)', 학생용 'AI 도우미')
# 키: https://console.anthropic.com → API Keys. 서버에서만 쓰입니다.
ANTHROPIC_API_KEY=
# 쓸 Claude 모델 이름. 코드에 박지 않고 여기서 바꾼다 (CLAUDE.md)
ANTHROPIC_MODEL=claude-opus-5-5
# 학생 AI 도우미에 쓸 모델 (비우면 위 ANTHROPIC_MODEL을 씀). 질문 한 번에 어림값:
#   claude-haiku-5-5 약 0.1센트 / claude-sonnet-5-5 약 2센트 / claude-opus-5-5 약 4센트
ANTHROPIC_HELPER_MODEL=
# 교사 채점 보조(AI 채점 초안)에 쓸 모델 (비우면 ANTHROPIC_MODEL). 제출 하나에 어림값: opus 약 5센트 / sonnet 약 2센트 / haiku 약 0.2센트
ANTHROPIC_GRADER_MODEL=
# 학생 한 명이 하루(한국 시간)에 AI 도우미에게 물어볼 수 있는 횟수 (비우면 50)
AI_DAILY_LIMIT_PER_STUDENT=50
# 연습 모드: 학생 한 명이 하루에 만들 수 있는 연습 문제 수 (없으면 7). 모델은 ANTHROPIC_HELPER_MODEL을 함께 씀
PRACTICE_DAILY_LIMIT=7
# 체험 페이지(/try, 로그인 없음): 이 코드를 넣은 브라우저만 진짜 AI(도우미·되돌아보기)를 씀. 비우면 체험 AI는 꺼지고 예시 기록만 보임.
# 심사위원 접속 안내문에만 적어 두세요 (학생에게 알려 주지 않기)
TRY_ACCESS_CODE=
# 체험 AI를 사이트 전체에서 하루(한국 시간)에 부를 수 있는 횟수 (비우면 30). 도우미 질문·되돌아보기·이어 묻기를 모두 셈
TRY_AI_DAILY_LIMIT=30
